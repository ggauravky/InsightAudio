# ==============================================================================
# InsightAudio - Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ── Google Gemini (Required for Summarization & RAG Engine) ──────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional: GEMINI_MODEL="gemini-1.5-flash" (or "gemini-2.0-flash", "gemini-1.5-pro")
GEMINI_MODEL="gemini-1.5-flash"

# ── Sarvam AI (Optional / Indic Language STT: Hindi & Hinglish) ──────────────
# Get your API key at: https://www.sarvam.ai/
SARVAM_API_KEY="your_sarvam_api_key_here"

# ── Whisper Configuration (Local STT) ─────────────────────────────────────────
# Model size: 'tiny', 'base', 'small', 'medium', 'large-v3' (Default: 'small')
WHISPER_MODEL="small"

# ── Vector Database & Storage Settings ───────────────────────────────────────
CHROMA_DB_DIR="./vector_db"
DOWNLOAD_DIR="./downloads"
EXPORT_DIR="./exports"
