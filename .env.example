# ==============================================================================
# InsightAudio - Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ── Mistral AI (Required for Summarization & RAG Engine) ─────────────────────
# Get your free API key at: https://console.mistral.ai/
MISTRAL_API_KEY="your_mistral_api_key_here"

# ── Sarvam AI (Optional / Indic Language STT: Hindi & Hinglish) ──────────────
# Get your API key at: https://www.sarvam.ai/
SARVAM_API_KEY="your_sarvam_api_key_here"

# ── Whisper Configuration (Local STT) ─────────────────────────────────────────
# Model size: 'tiny', 'base', 'small', 'medium', 'large-v3' (Default: 'base')
WHISPER_MODEL_SIZE="base"

# ── Vector Database & Storage Settings ───────────────────────────────────────
CHROMA_DB_DIR="./data/chromadb"
DOWNLOAD_DIR="./downloads"
EXPORT_DIR="./exports"
